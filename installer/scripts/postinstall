#!/bin/bash
# Lance Copiste dans la session de l'utilisateur connecté (le script tourne en root).
USER_NAME=$(stat -f %Su /dev/console)
USER_ID=$(id -u "$USER_NAME" 2>/dev/null)
if [ -n "$USER_ID" ] && [ "$USER_NAME" != "root" ]; then
    launchctl asuser "$USER_ID" sudo -u "$USER_NAME" open -a "/Applications/Copiste.app" || true
fi
exit 0
